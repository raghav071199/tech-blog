---
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import Layout from '../layouts/BlogPost.astro';
import { SOCIAL_LINKS } from '../consts';

const stack = [
	{
		group: 'Languages',
		items: ['Kotlin', 'Java', 'TypeScript', 'Python', 'SQL', 'C/C++', 'Bash'],
	},
	{
		group: 'Android',
		items: ['Android SDK', 'Jetpack', 'Material Design', 'WebView', 'Gradle', 'React Native'],
	},
	{
		group: 'Testing',
		items: ['JUnit', 'Mockito', 'Espresso', 'Maestro (E2E)', 'AndroidX Test'],
	},
	{
		group: 'Backend & Infra',
		items: ['Spring Boot', 'Microservices', 'REST APIs', 'Node.js', 'Docker', 'Kubernetes', 'Redis', 'Linux'],
	},
	{
		group: 'AWS',
		items: ['ECS/EC2', 'Lambda', 'DynamoDB', 'S3', 'CloudWatch', 'CloudFront', 'Data Pipeline', 'SageMaker'],
	},
];
---

<Layout
	title="About"
	description="SDE II at Amazon with 4 years building Android apps and the distributed systems behind them."
	pubDate={new Date('July 25 2026')}
	heroImage={AboutHeroImage}
>
	<p>
		I'm Raghav — a Software Development Engineer II at Amazon with four years of
		experience building mobile products end-to-end, from Android client
		architecture down to the distributed services and AWS infrastructure that
		power them. I care about systems that stay correct and fast as they scale,
		and about the design decisions that get them there.
	</p>

	<h2>What I work on</h2>
	<ul>
		<li>
			<strong>Android app architecture</strong> — offline-first sync, resilient
			API contracts, and testable UI.
		</li>
		<li>
			<strong>Backend services</strong> — Spring Boot microservices, REST APIs,
			caching, and containerized deploys.
		</li>
		<li>
			<strong>Cloud &amp; delivery</strong> — AWS (ECS/EC2, Lambda, DynamoDB, S3,
			CloudFront), CI/CD, and observability.
		</li>
	</ul>

	<h2>Tech I reach for</h2>
	<dl class="stack">
		{
			stack.map((row) => (
				<div class="stack-row">
					<dt>{row.group}</dt>
					<dd>
						<ul class="chips">
							{row.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</dd>
				</div>
			))
		}
	</dl>

	<h2>Why I write</h2>
	<p>
		Every post follows a STAR + Architecture format: the situation, the
		constraints, the design I landed on, and why — with diagrams. It's the
		technical reasoning I'd want a teammate (or a hiring manager) to see, not
		just the finished answer.
	</p>

	<h2>Get in touch</h2>
	<ul class="contact">
		<li><a href={SOCIAL_LINKS.email}>Email</a></li>
		<li><a href={SOCIAL_LINKS.resume} target="_blank" rel="noopener">Résumé (PDF)</a></li>
		<li><a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">GitHub</a></li>
		<li><a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
	</ul>
</Layout>

<style>
	.stack {
		margin: 0 0 2em;
	}
	.stack-row {
		display: grid;
		grid-template-columns: 160px 1fr;
		gap: 1rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.stack dt {
		font-weight: 700;
		color: rgb(var(--black));
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.chips li {
		font-size: 0.8rem;
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
	}
	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		list-style: none;
		padding: 0;
	}
	@media (max-width: 720px) {
		.stack-row {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}
	}
</style>
