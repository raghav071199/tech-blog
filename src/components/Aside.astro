---
// A callout box for asides, notes, and disambiguations within posts.
interface Props {
	title?: string;
}
const { title } = Astro.props;
---

<aside class="aside">
	{title && <p class="aside-title">{title}</p>}
	<div class="aside-body">
		<slot />
	</div>
</aside>

<style>
	.aside {
		margin: 1.75rem 0;
		padding: 1rem 1.25rem;
		border-left: 4px solid var(--accent);
		border-radius: 0 8px 8px 0;
		background: rgba(var(--gray-light), 0.5);
	}
	.aside-title {
		margin: 0 0 0.4rem;
		font-weight: 700;
		color: rgb(var(--black));
	}
	.aside-body :global(> :first-child) {
		margin-top: 0;
	}
	.aside-body :global(> :last-child) {
		margin-bottom: 0;
	}
</style>
